#!/bin/sh
# Blocks commits that would publish data, secrets or local agent files.
# Enabled with: git config core.hooksPath scripts/githooks

bad=$(git diff --cached --name-only --diff-filter=ACMR | grep -E \
  '(^|/)(data|raw)/|\.(parquet|csv|tsv|bz2|zip|gz)$|(^|/)\.env|kaggle\.json|access_token|(^|/)CLAUDE\.md$|(^|/)\.claude/')

if [ -n "$bad" ]; then
  echo "pre-commit: blocked. These files must not be committed:" >&2
  echo "$bad" >&2
  exit 1
fi

# Secret-looking strings in staged changes (Kaggle, GitHub, generic keys)
if git diff --cached -U0 | grep -E '^\+' | grep -qE 'KGAT_[A-Za-z0-9]+|ghp_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9]{20,}'; then
  echo "pre-commit: blocked. A staged line looks like a secret token." >&2
  exit 1
fi
exit 0
